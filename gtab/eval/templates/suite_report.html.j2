<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>gtab 평가 {{ summary.suite }} · {{ summary.system }}</title>
<style>
:root { --bg:#fff; --fg:#1d1d1f; --muted:#6b6b70; --line:#e3e3e6; --accent:#2563eb; --bad:#b91c1c; --good:#15803d; }
@media (prefers-color-scheme: dark) { :root { --bg:#141416; --fg:#ececf0; --muted:#9a9aa3; --line:#2c2c31; --accent:#60a5fa; --bad:#f87171; --good:#4ade80; } }
body { background:var(--bg); color:var(--fg); font:14px/1.5 "Malgun Gothic", system-ui, sans-serif; margin:0 auto; max-width:1100px; padding:16px; }
h1 { font-size:20px; } h2 { font-size:16px; margin-top:28px; border-bottom:1px solid var(--line); padding-bottom:4px; }
table { border-collapse:collapse; margin:8px 0; font-variant-numeric:tabular-nums; }
th, td { border-bottom:1px solid var(--line); padding:3px 8px; text-align:right; }
th:first-child, td:first-child { text-align:left; }
.muted { color:var(--muted); } .note { color:var(--bad); font-weight:600; }
.scroll { overflow-x:auto; } svg { max-width:100%; height:auto; }
a { color:var(--accent); }
</style>
</head>
<body>
<h1>평가: {{ summary.suite }} · 시스템 {{ summary.system }}</h1>
<p class="muted">항목 {{ summary.n_items }}개{% if summary.skipped %} · 예측 없음 {{ summary.skipped|length }}개{% endif %} · 실행 폴더 {{ run_name }}</p>
{% if summary.note %}<p class="note">{{ summary.note }}</p>{% endif %}

<h2>집계 (곡 블록 부트스트랩 95 % CI)</h2>
<div class="scroll"><table>
<tr><th>지표</th><th>값</th><th>CI 하한</th><th>CI 상한</th><th>항목 수</th></tr>
{% for k, v in summary.aggregates.items() %}
<tr><td>{{ k }}</td><td>{{ fmt(v.value) }}</td><td>{{ fmt(v.ci[0]) }}</td><td>{{ fmt(v.ci[1]) }}</td><td>{{ v.n_items }}</td></tr>
{% endfor %}
</table></div>

{% if summary.baselines %}
<h2>기준선</h2>
<table><tr><th>기준선</th><th>값</th><th>CI</th></tr>
{% for k, v in summary.baselines.items() %}<tr><td>{{ k }}</td><td>{{ fmt(v.value) }}</td><td>{{ fmt(v.ci[0]) }} – {{ fmt(v.ci[1]) }}</td></tr>{% endfor %}
</table>
{% endif %}

{% if summary.mde_checks %}
<h2>MDE 점검</h2>
<table><tr><th>지표</th><th>CI 반폭(점)</th><th>MDE(점)</th><th>MDE 판별 가능</th></tr>
{% for k, v in summary.mde_checks.items() %}<tr><td>{{ k }}</td><td>{{ fmt(v.ci_half_width_points) }}</td><td>{{ fmt(v.mde_points) }}</td><td>{{ "예" if v.resolves_mde else "아니오" }}</td></tr>{% endfor %}
</table>
{% endif %}

<h2>시나리오별 (항목 평균)</h2>
<div class="scroll"><table>
<tr><th>시나리오</th>{% for m in scenario_metrics %}<th>{{ m }}</th>{% endfor %}<th>항목</th></tr>
{% for sc, vals in by_scenario.items() %}
<tr><td>{{ sc or "-" }}</td>{% for m in scenario_metrics %}<td>{{ fmt(vals.get(m)) }}</td>{% endfor %}<td>{{ vals.n }}</td></tr>
{% endfor %}
</table></div>

<h2>항목별</h2>
<div class="scroll"><table>
<tr><th>항목</th><th>시나리오</th>{% for m in item_metrics %}<th>{{ m }}</th>{% endfor %}</tr>
{% for it in items %}
<tr><td>{{ it.item }}</td><td>{{ it.scenario }}</td>{% for m in item_metrics %}<td>{{ fmt(it.vals.get(m)) }}</td>{% endfor %}</tr>
{% endfor %}
</table></div>

<h2>Line별 onset F1 (헝가리안 매핑 후)</h2>
<div class="scroll"><table>
<tr><th>항목</th><th>Line</th><th>F1</th><th>tp</th><th>fp</th><th>fn</th></tr>
{% for r in line_rows %}<tr><td>{{ r.item }}</td><td>{{ r.line }}</td><td>{{ fmt(r.value) }}</td><td>{{ r.tp }}</td><td>{{ r.fp }}</td><td>{{ r.fn }}</td></tr>{% endfor %}
</table></div>

<h2>파트 혼동 행렬 (행 = 예측 Line, 열 = 정답 Line)</h2>
{% for d in details[:max_confusions] %}
<p><b>{{ d.item }}</b> <span class="muted">매핑 {{ d.confusion.mapping }}</span></p>
<table><tr><th></th>{% for g in d.confusion.gt_lines %}<th>{{ g }}</th>{% endfor %}</tr>
{% for p in d.confusion.pred_lines %}<tr><td>{{ p }}</td>{% for v in d.confusion.matrix[loop.index0] %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}
</table>
{% endfor %}
{% if details|length > max_confusions %}<p class="muted">… {{ details|length - max_confusions }}개 생략</p>{% endif %}

<h2>coverage–accuracy 곡선 (Unassigned 문턱 τ)</h2>
{% if coverage_svg %}{{ coverage_svg|safe }}{% else %}<p class="muted">사후확률이 없는 예측이라 점 하나뿐입니다.</p>{% endif %}

<h2>최악 마디 (상위 {{ worst|length }})</h2>
<table><tr><th>항목</th><th>마디</th><th>누락</th><th>오탐</th><th>Line 오배정</th><th>합</th></tr>
{% for w in worst %}
<tr><td>{{ w.item }}</td><td>{% if w.song_key %}<a href="gtab://job/{{ w.song_key }}?bar={{ w.bar }}">{{ w.bar }}</a>{% else %}{{ w.bar }}{% endif %}</td>
<td>{{ w.missed }}</td><td>{{ w.extra }}</td><td>{{ w.wrong_line }}</td><td>{{ w.total }}</td></tr>
{% endfor %}
</table>
<p class="muted">마디 링크(gtab://job/…)는 M4 UI에서 열린다.</p>
</body>
</html>
